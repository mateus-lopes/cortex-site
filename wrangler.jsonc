{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cortex",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Toda requisição passa pelo worker, que confere a sessão (senha) antes de servir qualquer arquivo
    "run_worker_first": true
  },
  "workers_dev": true,
  "preview_urls": false
}
